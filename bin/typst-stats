#!/usr/bin/env bash
#
# Generate the statistics PDF for one class from its correzioni folder.

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: typst-stats <correzioni-folder> [options]

  <correzioni-folder>  Folder containing the class correction descriptors and
                       the sibling ../manifest.json.

Options:
  -o, --out <file>   Output PDF (default: the class exam's misc/stats.pdf)
  -r, --root <dir>   Typst project root (default: first parent containing
                     typst-components/src/lib.typ)
  -h, --help         Show this help
EOF
}

die() {
  printf 'typst-stats: %s\n' "$*" >&2
  exit 1
}

quote_typst() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  printf '"%s"' "$value"
}

out=""
root=""
positional=()

while (($#)); do
  case "$1" in
    -o|--out)
      (($# >= 2)) || die "missing value for $1"
      out="$2"
      shift 2
      ;;
    -o=*|--out=*)
      out="${1#*=}"
      shift
      ;;
    -r|--root)
      (($# >= 2)) || die "missing value for $1"
      root="$2"
      shift 2
      ;;
    -r=*|--root=*)
      root="${1#*=}"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      positional+=("$@")
      break
      ;;
    -*)
      die "unknown option: $1"
      ;;
    *)
      positional+=("$1")
      shift
      ;;
  esac
done

((${#positional[@]} == 1)) || {
  usage >&2
  exit 2
}

correzioni_dir="${positional[0]}"
[[ -d "$correzioni_dir" ]] || die "correzioni folder not found: $correzioni_dir"
correzioni_dir="$(cd -- "$correzioni_dir" && pwd -P)"

exam_dir="$(dirname -- "$correzioni_dir")"
manifest="$exam_dir/manifest.json"
[[ -f "$manifest" ]] || die "manifest not found: $manifest"

if [[ -n "$root" ]]; then
  [[ -d "$root" ]] || die "project root not found: $root"
  root="$(cd -- "$root" && pwd -P)"
else
  candidate="$correzioni_dir"
  while :; do
    if [[ -f "$candidate/typst-components/src/lib.typ" ]]; then
      root="$candidate"
      break
    fi
    [[ "$candidate" == "/" ]] && break
    candidate="$(dirname -- "$candidate")"
  done
  [[ -n "$root" ]] || die "could not find typst-components above $correzioni_dir (use --root)"
fi

command -v typst >/dev/null 2>&1 || die "typst is not installed or not in PATH"

correzioni_rel="$(realpath --relative-to="$root" "$correzioni_dir")"
correzioni_arg="/$correzioni_rel"

if [[ -z "$out" ]]; then
  out="$exam_dir/misc/stats.pdf"
fi
mkdir -p -- "$(dirname -- "$out")"

tmpdir="$(mktemp -d "$root/.typst-stats.XXXXXX")"
trap 'rm -rf -- "$tmpdir"' EXIT
stub="$tmpdir/stats.typ"

{
  printf '#import "/typst-components/src/lib.typ": render-stats\n\n'
  printf '#render-stats(%s)\n' "$(quote_typst "$correzioni_arg")"
} > "$stub"

typst compile --root "$root" "$stub" "$out"
printf 'typst-stats: wrote %s\n' "$out"
